python3 tools/generate_catalogue.py --check
./gradlew :server:detekt :server:test --tests '*RenderTest.aFullVacuum*'
cd editor && npm test -- --run src/model/otherTiles.test.ts
./gradlew :shared:test --tests '*ProjectRuleIndexTest'
