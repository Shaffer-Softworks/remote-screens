  "services": {
    "show_alert": {
      "name": "Show alert",
      "description": "Shows a message over the screens, with an optional camera and up to two buttons.",
      "fields": {
        "screens": { "name": "Screens", "description": "The screens to show it on; none is every screen." },
        "title": { "name": "Title", "description": "The alert's title." },
        "message": { "name": "Message", "description": "Text under the title." },
        "icon": { "name": "Icon", "description": "An MDI icon." },
        "level": { "name": "Level", "description": "Colours the alert." },
        "camera": { "name": "Camera", "description": "A camera shown under the message, such as the doorbell." },
        "buttons": { "name": "Buttons", "description": "Up to two buttons, each with a title and an optional service and data. A button also fires remote_screens_alert_action." },
        "timeout": { "name": "Timeout", "description": "Seconds before it closes by itself; 0 keeps it until tapped." },
        "tag": { "name": "Tag", "description": "Sent back in remote_screens_alert_action, so an automation can tell alerts apart." }
      }
    },
    "open_page": {
      "name": "Open page",
      "description": "Opens a page on the screens, waking them.",
      "fields": {
        "screens": { "name": "Screens", "description": "The screens; none is every screen." },
        "page": { "name": "Page", "description": "The page's title, id or number (1 is the first)." }
      }
    },
    "wake": {
      "name": "Wake",
      "description": "Wakes the screens from standby.",
      "fields": {
        "screens": { "name": "Screens", "description": "The screens; none is every screen." }
      }
    },
    "close": {
      "name": "Close",
      "description": "Closes alerts and cards shown over the pages.",
      "fields": {
        "screens": { "name": "Screens", "description": "The screens; none is every screen." }
      }
    }
  }
